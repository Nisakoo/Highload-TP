flowchart TB
    C["Клиент"]
    CDN["CDN<br/>статика"]
    PP["Платежный провайдер"]
    YS["Яндекс Поиск"]

    subgraph ENTRY["Вход"]
        R["Внешняя балансировка (Anycast, GeoDNS)"]
        LB4["DPVS<br/>L4, DR, Maglev"]
        NG["Nginx<br/>L7, TLS, проверка JWT, маршрутизация по домену"]
    end
    subgraph ONLINE["Контур инференса"]
        subgraph AUTH["auth-service"]
            AUTHS["auth"]
            AUTHPG[("PostgreSQL<br/>credentials")]
            AUTHRS[("Redis<br/>sessions")]
        end

        subgraph USRG["user-service"]
            USRS["user"]
            USRR["outbox relay"]
            USRPG[("PostgreSQL<br/>users, profiles, settings, outbox")]
        end

        subgraph DLG["dialog-service"]
            DLGS["dialog"]
            DLGR["outbox relay"]
            SC[("ScyllaDB<br/>dialogs, messages, outbox")]
        end

        subgraph CHAT["chat-orchestrator"]
            GW["Inference Gateway<br/>оркестратор саги генерации, stateless"]
            PB["prompt-builder"]
            EXT["упрощённый разбор<br/>TXT, DOCX, PDF"]
            LQ["локальный счетчик квоты"]
        end

        subgraph INF["inference-router"]
            IR["router<br/>выбор GPU-узла, снимок конфига"]
        end

        subgraph QUOTA["quota-service"]
            QS["quota"]
            QR[("Redis<br/>счетчики и лимиты тарифа")]
        end

        subgraph BILL["billing-service"]
            BS["billing<br/>оркестратор саги оплаты"]
            BSR["outbox relay"]
            BPG[("PostgreSQL<br/>plans, subscriptions, payments,<br/>payment_methods, payment_events, refunds, outbox")]
        end

        subgraph UPL["upload-service"]
            US["upload"]
            CONV["file-converter"]
            UPR["outbox relay"]
            UR[("Redis<br/>метаданные uploads, outbox")]
        end

        subgraph CTX["context-service"]
            CTXS["context"]
            CTXR[("Redis<br/>dialog_context_cache")]
        end

        subgraph GPUC["GPU-кластер"]
            subgraph LLMG["llm-service"]
                SG["SGLang"]
            end

            subgraph LLMS["llm-service, малая модель"]
                SGS["SGLang"]
            end

            subgraph STTG["stt-service"]
                STT["Whisper"]
            end
        end

        subgraph TTSG["tts-service"]
            TTS["Silero"]
        end

        subgraph WSG["web-search-service"]
            WS["web-search"]
            WR[("Redis<br/>web_cache")]
        end

        subgraph REG["model-registry"]
            MR["model-registry"]
            MRPG[("PostgreSQL<br/>base_models, model_versions, доли выкатки")]
        end

        GC["blob<br/>garbage collector"]
        FA["frontend-analytics"]
    end

    subgraph TRAIN["Контур обучения"]
        SMP["sampler<br/>0,1% ответов, allow_training"]
        TO["training-orchestrator<br/>оркестратор саги обучения"]
        TR["outbox relay"]
        TPG[("PostgreSQL<br/>training_samples, datasets,<br/>training_runs, checkpoints, evaluations, outbox")]
        SP["dataset-builder"]
        PT["trainer"]
        EV["evaluator"]
        subgraph GPUT["GPU-кластер обучения"]
            GT["DeepSpeed"]
            GE["lm-evaluation-harness"]
        end
    end

    CEPH[("Ceph<br/>blobs, временный бакет, статика,<br/>датасеты, checkpoints, адаптеры")]

    KSAGA[["Kafka: саги чата<br/>quota.reserve, quota.release, quota.commit,<br/>message.save, upload.attach"]]
    KBIL[["Kafka: биллинг<br/>payment.succeeded, subscription.activated,<br/>quota.limits"]]
    KEV[["Kafka: доменные события<br/>user.created, message.completed, dialog.deleted,<br/>upload.assembled, blob.created, model.published,<br/>request.finished"]]
    KTR[["Kafka: обучение<br/>dataset.build, train, eval, model.publish"]]
    KLOG[["Kafka: логи"]]
    KFE[["Kafka: события фронтенда"]]
    KDLQ[["Kafka: DLQ"]]

    subgraph DWHG["DWH"]
        DL["kafka-loader<br/>worker pool"]
        DWH[("ClickHouse DWH<br/>fact_requests,<br/>справочники users, plans, model_versions")]
    end

    subgraph MON["Мониторинг"]
        PR["Prometheus"]
        PGW["Pushgateway"]
        AM["Alertmanager"]
        MI[("Grafana Mimir<br/>метрики")]
        OT["OTel Collector<br/>сэмплирование"]
        TE[("Grafana Tempo<br/>трейсы")]
        CHL[("ClickHouse<br/>логи")]
        GF["Grafana"]
    end

    %% Вход
    C -->|"read: статика"| CDN
    CDN -->|"read: origin"| CEPH
    C --> R
    PP -->|"push: вебхуки"| R
    R -->|"BGP + ECMP"| LB4 --> NG
    NG -->|"auth: регистрация, вход (получение refresh и access токенов)"| AUTHS
    NG -->|"user: round robin"| USRS
    NG -->|"dialog: round robin"| DLGS
    NG -->|"billing: round robin"| BS
    NG -->|"вебхуки: проверка подписи провайдера"| BS
    NG -->|"upload: least conn"| US
    NG -->|"chat, voice: least conn<br/>SSE: push токенов клиенту"| GW
    NG -->|"статистика: round robin"| FA

    %% auth
    NG -.->|"pull: JWKS, снимок публичных ключей подписи"| AUTHS
    AUTHS -->|"read/write: credentials"| AUTHPG
    AUTHS -->|"read/write: refresh-сессии"| AUTHRS
    BS -->|"read: проверка сессии при оплате и смене тарифа"| AUTHS
    AUTHS -->|"write: создание пользователя, идемпотентно по логину"| USRS

    %% user
    USRS -->|"read/write: users, profiles"| USRPG
    USRR -->|"read: outbox"| USRPG
    USRR -.->|"write: user.created, user.updated"| KEV

    %% dialog
    DLGS -->|"read/write: dialogs, messages"| SC
    DLGR -->|"read: outbox"| SC
    DLGR -.->|"write: message.completed, dialog.deleted"| KEV

    %% Сага генерации ответа
    GW -.->|"write: команды саги с user_id"| KSAGA
    KSAGA -.->|"read: ответы участников"| GW
    KSAGA -.->|"read: quota.reserve, quota.commit, quota.release"| QS
    QS -.->|"write: ответ саге"| KSAGA
    KSAGA -.->|"read: message.save"| DLGS
    DLGR -.->|"write: ответ саге"| KSAGA
    KSAGA -.->|"read: upload.attach"| US
    UPR -.->|"write: ответ саге"| KSAGA

    %% Синхронные вызовы генерации
    GW --> PB
    PB -->|"read/write: контекст"| CTXS
    PB -->|"read: вложения"| CEPH
    PB -->|"fallback: вложение без file-converter"| EXT
    EXT -->|"read: оригинал файла"| CEPH
    PB -->|"fallback: последние N сообщений"| DLGS
    GW -->|"gRPC stream: запрос генерации"| IR
    GW -->|"fallback: при отказе quota-service"| LQ
    IR -->|"gRPC stream: hash dialog_id"| SG
    IR -->|"fallback: малая модель"| SGS
    KEV -.->|"read: model.published, снимок конфига моделей и доли выкатки"| IR
    IR -->|"least request"| STT
    IR -->|"gRPC stream: текст в аудио"| TTS
    IR -->|"least request"| WS
    GW -.->|"write: request.finished"| KEV

    QS -->|"read/write: квоты"| QR

    CTXS -->|"read/write: ctx"| CTXR
    CTXS -->|"read: история при промахе"| DLGS
    KEV -.->|"read: dialog.deleted"| CTXS

    SG -->|"read: веса, LoRA-адаптер"| CEPH
    SGS -->|"read: веса"| CEPH
    TTS -->|"write: готовое аудио для повтора"| CEPH

    WS -->|"read/write: web_cache"| WR
    WS -->|"read: circuit breaker"| YS

    %% upload
    US -->|"reserve, commit, release файла"| QS
    US -->|"read/write: uploads"| UR
    US -->|"write: части, S3 Multipart"| CEPH
    UPR -->|"read: outbox"| UR
    UPR -.->|"write: upload.assembled, blob.created"| KEV
    KEV -.->|"read: upload.assembled"| CONV
    CONV -->|"read/write: файлы"| CEPH
    CONV -->|"write: status"| UR
    KEV -.->|"read: dialog.deleted"| US

    %% Сага оплаты
    BS -->|"read/write: подписки, платежи"| BPG
    BS -->|"списание, возврат"| PP
    BSR -->|"read: outbox"| BPG
    BSR -.->|"write: команды саги, subscription.activated"| KBIL
    KBIL -.->|"read: ответы"| BS
    KBIL -.->|"read: quota.limits"| QS
    KBIL -.->|"read: quota.limits, снимок лимитов"| LQ
    QS -.->|"write: ответ саге"| KBIL
    KEV -.->|"read: user.created"| BS

    %% blob-gc
    KEV -.->|"read: dialog.deleted, blob.created"| GC
    GC -->|"write: удаление blobs"| CEPH

    %% model-registry
    MR -->|"read/write: версии"| MRPG
    MR -.->|"write: model.published"| KEV

    %% Сага обучения
    KEV -.->|"read: message.completed, dialog.deleted"| SMP
    SMP -->|"write: training_samples"| TPG
    SMP -->|"write: тексты, raw"| CEPH
    TO -->|"read/write: runs, datasets"| TPG
    TR -->|"read: outbox"| TPG
    TR -.->|"write: команды саги"| KTR
    KTR -.->|"read: ответы"| TO
    KTR -.->|"pull: dataset.build"| SP
    KTR -.->|"pull: train"| PT
    KTR -.->|"pull: eval"| EV
    KTR -.->|"read: model.publish"| MR
    SP & PT & EV & MR -.->|"write: ответ саге"| KTR
    SP -->|"read/write: датасеты"| CEPH
    PT -->|"read/write: checkpoints"| CEPH
    EV -->|"read: checkpoint"| CEPH
    PT -->|"запуск обучения"| GT
    EV -->|"запуск оценки"| GE

    %% DWH
    KEV -.->|"read: request.finished, user.created, model.published"| DL
    KBIL -.->|"read: subscription.activated"| DL
    FA -.->|"write: события клиента"| KFE
    KFE -.->|"read: события клиента"| DL
    DL -->|"write: батчи"| DWH
    DL -->|"write: батчи"| CHL

    %% DLQ
    ONLINE -.->|"write: после N ретраев"| KDLQ
    TRAIN -.->|"write: после N ретраев"| KDLQ

    %% Мониторинг
    PR -->|"pull: scrape /metrics"| ONLINE
    PR -->|"pull: scrape /metrics"| PGW
    SP & PT & EV & GC -->|"push: метрики batch-задач"| PGW
    PR -->|"push: remote_write"| MI
    PR -->|"push: алерты"| AM
    ONLINE -->|"push: OTLP трейсы, логи"| OT
    TRAIN -->|"push: OTLP трейсы, логи"| OT
    OT -->|"push: трейсы"| TE
    OT -.->|"write: логи"| KLOG
    KLOG -.->|"read: логи"| DL
    MI -->|"write: блоки"| CEPH
    TE -->|"write: блоки"| CEPH
    GF -->|"read: PromQL"| MI
    GF -->|"read: TraceQL"| TE
    GF -->|"read: SQL"| CHL
    GF -->|"read: SQL"| DWH

    %% Микросервисы
    style AUTH fill:#dcfce7,stroke:#16a34a,color:#111
    style USRG fill:#dcfce7,stroke:#16a34a,color:#111
    style DLG fill:#dcfce7,stroke:#16a34a,color:#111
    style CHAT fill:#dcfce7,stroke:#16a34a,color:#111
    style INF fill:#dcfce7,stroke:#16a34a,color:#111
    style QUOTA fill:#dcfce7,stroke:#16a34a,color:#111
    style BILL fill:#dcfce7,stroke:#16a34a,color:#111
    style UPL fill:#dcfce7,stroke:#16a34a,color:#111
    style CTX fill:#dcfce7,stroke:#16a34a,color:#111
    style LLMG fill:#dcfce7,stroke:#16a34a,color:#111
    style LLMS fill:#dcfce7,stroke:#16a34a,color:#111
    style STTG fill:#dcfce7,stroke:#16a34a,color:#111
    style TTSG fill:#dcfce7,stroke:#16a34a,color:#111
    style WSG fill:#dcfce7,stroke:#16a34a,color:#111
    style REG fill:#dcfce7,stroke:#16a34a,color:#111
    style GPUT fill:#dcfce7,stroke:#16a34a,color:#111
